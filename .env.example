# Override the Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Override the default model (default: qwen2.5-coder:7b -- qwen2.5-coder:32b needs
# ~20GB+ RAM/VRAM and will thrash on a 16GB machine; only use it if you have the memory)
MINI_SWE_MODEL=qwen2.5-coder:7b
